{
  "name": "@ludovicm67/scheduler",
  "version": "0.2.2",
  "description": "A simple Node.js based tasks and services scheduler",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "type": "module",
  "bin": {
    "cli": "./dist/index.js"
  },
  "scripts": {
    "start": "node src/index.ts",
    "knip": "knip",
    "build": "rm -rf dist && tsc && pnpm run update-schema && vite build && chmod +x dist/index.js && pnpm run fix-types",
    "prepack": "pnpm run build",
    "update-schema": "node src/scripts/update-schema.ts",
    "fix-types": "node src/scripts/fix-types.ts",
    "release": "changeset publish",
    "test": "node --experimental-strip-types --test tests/*.test.ts"
  },
  "keywords": [
    "scheduler"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ludovicm67/node-scheduler.git"
  },
  "author": {
    "name": "Ludovic Muller",
    "url": "https://ludovic-muller.fr/"
  },
  "funding": {
    "type": "github",
    "url": "https://github.com/sponsors/ludovicm67"
  },
  "files": [
    "dist"
  ],
  "license": "Apache-2.0",
  "dependencies": {
    "commander": "^15.0.0",
    "express": "^5.2.1",
    "node-cron": "^4.6.0",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "uuid": "^14.0.2",
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.1",
    "@types/express": "^5.0.6",
    "knip": "^6.32.2",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vite-plugin-static-copy": "^4.1.1"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "packageManager": "pnpm@11.23.0+sha512.f00082e5b283a199b74e079da28d155c008fe232f44c8a06ea7ddfa014ecf719fc362f790ecc67b28106ddac2afb24c49a9a079159da560b2ce7d1e98efd11af"
}
